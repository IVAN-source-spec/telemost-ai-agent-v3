services:
  telemost-bot-1:
    build:
      context: .
      dockerfile: Dockerfile
    container_name: telemost-bot-1
    restart: unless-stopped
    env_file:
      - .env
    environment:
      PULSE_SERVER: unix:/run/user/1002/pulse/native
      PULSE_SINK: virtual_sink_bot_1
      PULSE_SOURCE: virtual_sink_bot_1.monitor
      TELEMOST_AUDIO_SOURCE_NAME: virtual_sink_bot_1.monitor
      TELEMOST_AUTH_STATE_PATH: data/auth/yandex-session.json
      TELEMOST_AUTH_COOKIES_PATH: data/auth/cookies.json
      TELEMOST_BOT_POOL_SIZE: "1"
      BOT_NODE_ID: telemost-vm-3-bot-1
      BOT_NODE_NAME: "Третья VM Bot 1"
    command:
      - sh
      - -lc
      - >
        rm -f /tmp/.X99-lock /tmp/.X11-unix/X99;
        Xvfb :99 -screen 0 1280x1024x24 -nolisten tcp &
        for n in $(seq 1 40); do
          [ -S /tmp/.X11-unix/X99 ] && break;
          sleep 0.25;
        done;
        export DISPLAY=:99;
        exec python api_run.py
    ports:
      - "8001:8000"
    volumes:
      - ./data/auth:/app/data/auth:ro
      - ./recordings/bot-1:/app/recordings
      - ./yandex_disk_upload_errors_bot_1.jsonl:/app/yandex_disk_upload_errors.jsonl
      - /run/user/1002/pulse/native:/run/user/1002/pulse/native
      - /home/razumadmin/.config/pulse/cookie:/root/.config/pulse/cookie:ro
    shm_size: "2gb"

